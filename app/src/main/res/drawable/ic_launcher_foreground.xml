<?xml version="1.0" encoding="utf-8"?>
<!-- Nested-checklist motif: three stacked, indented rows with check ticks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Row 1 (parent) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,36 h44 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-44 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <!-- Row 2 (child, indented) -->
    <path
        android:fillColor="#CFE5FF"
        android:pathData="M42,54 h36 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-36 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />
    <!-- Row 3 (grandchild, indented more) -->
    <path
        android:fillColor="#CFE5FF"
        android:pathData="M52,72 h26 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-6 a3,3 0 0 1 3,-3 z" />

    <!-- Check tick on the parent row -->
    <path
        android:strokeColor="#37618E"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M34,42 l3,3 l6,-6" />
</vector>
